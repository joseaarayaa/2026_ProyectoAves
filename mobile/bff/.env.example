# URL del backend Phoenix (sin barra final).
BACKEND_URL=http://localhost:4000

# Puerto en el que escucha el BFF.
PORT=8080

# Cuenta de servicio para el feed público (GET /images sin sesión).
# El backend exige login en /api/photos; sin estas dos variables el feed
# solo funciona con un usuario autenticado. Usa un usuario sin privilegios.
SERVICE_EMAIL=
SERVICE_PASSWORD=

# Categorías de la app -> nombre de categoría del backend.
# Útil si en la base solo existen categorías como "Aves" y "Rapaces".
# Formato: clave_app=Nombre en backend, separados por comas.
CATEGORY_ALIASES=terrestres=Aves,otras=Aves

# Tamaño máximo de foto en bytes (el backend también limita a 5 MB).
MAX_UPLOAD_BYTES=5242880

# Tiempo máximo de espera al backend, en segundos.
BACKEND_TIMEOUT_SECONDS=15
